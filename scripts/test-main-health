#!/usr/bin/env python3
"""Test dispatch's Main health command against fixture `gh` output.

scripts/test-main-health [markdown file]  (default: dispatch/main-health.md)

Runs the first ```sh block of the file with bash, `<default branch>` set to
main, and a stub `gh` first on PATH that serves each case's fixture JSON and
applies `--jq` with jq. Needs bash and jq.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DEFAULT = ROOT / "plugins" / "workflow" / "skills" / "dispatch" / "main-health.md"

STUB = r"""#!/usr/bin/env bash
# gh stub: answers from $FIXTURE, applying --jq with jq.
jqf=; args=()
while [ $# -gt 0 ]; do
  if [ "$1" = --jq ]; then jqf=$2; shift 2; else args+=("$1"); shift; fi
done
case "${args[0]} ${args[1]}" in
  "api repos/{owner}/{repo}/commits/main") file=commit.json ;;
  "api repos/{owner}/{repo}/activity?ref=refs/heads/main&per_page=1") file=activity.json ;;
  "run list") file=runs.json ;;
  *) echo "gh stub: unexpected call: ${args[*]}" >&2; exit 2 ;;
esac
[ -f "$FIXTURE/$file" ] || { echo "gh stub: HTTP 404" >&2; exit 1; }
if [ -n "$jqf" ]; then jq -r "$jqf" "$FIXTURE/$file"; else cat "$FIXTURE/$file"; fi
"""

NOW = time.time()


def ago(seconds):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(NOW - seconds))


def run(sha, workflow, status, conclusion, age, url=None):
    return {"headSha": sha, "workflowName": workflow, "status": status, "conclusion": conclusion,
            "createdAt": ago(age), "url": url or f"https://run/{sha}/{workflow}/{age}"}


def push(sha, age):
    return [{"after": sha, "timestamp": ago(age), "activity_type": "pr_merge", "ref": "refs/heads/main"}]


OLD_GREEN = run("old", "ci", "completed", "success", 900)
OLD_RED = run("old", "ci", "completed", "failure", 900, "https://run/old-red")

# (name, head sha, activity (None: API fails), runs newest first, expected output[, commit date age])
CASES = [
    ("head green", "new", push("new", 600),
     [run("new", "ci", "completed", "success", 590), OLD_GREEN], "green"),
    ("head failed", "new", push("new", 600),
     [run("new", "ci", "completed", "failure", 590, "https://run/new-red"), OLD_GREEN], "red https://run/new-red"),
    ("head pushed just now, no run yet", "new", push("new", 10), [OLD_GREEN], "pending"),
    ("head without runs, pushed long ago, older green", "new", push("new", 600), [OLD_GREEN], "green"),
    ("head without runs, pushed long ago, older red", "new", push("new", 600), [OLD_RED], "red https://run/old-red"),
    ("old-dated commit pushed just now", "new", push("new", 10), [OLD_GREEN], "pending", 86400),
    ("activity API unavailable, head has no run", "new", None, [OLD_GREEN], "pending"),
    ("activity still shows previous push", "new", push("old", 900), [OLD_GREEN], "pending"),
    ("cancelled, superseded by newer success", "new", push("new", 600),
     [run("new", "ci", "completed", "success", 300), run("new", "ci", "completed", "cancelled", 590), OLD_GREEN],
     "green"),
    ("cancelled alone", "new", push("new", 600),
     [run("new", "ci", "completed", "cancelled", 590, "https://run/new-cancelled"), OLD_GREEN],
     "red https://run/new-cancelled"),
    ("in progress", "new", push("new", 600),
     [run("new", "ci", "in_progress", "", 590), OLD_GREEN], "pending"),
    ("one failed, one in progress", "new", push("new", 600),
     [run("new", "e2e", "in_progress", "", 580), run("new", "ci", "completed", "failure", 590, "https://run/new-ci"),
      OLD_GREEN], "red https://run/new-ci"),
    ("no CI at all, pushed long ago", "new", push("new", 600), [], "green"),
]


def command(markdown):
    match = re.search(r"```sh\n(.*?)\n```", markdown.read_text(encoding="utf-8"), re.S)
    if not match:
        sys.exit(f"test-main-health: no ```sh block in {markdown}")
    return match.group(1).replace("<default branch>", "main")


def main(markdown=DEFAULT):
    cmd = command(Path(markdown))
    failed = 0
    with tempfile.TemporaryDirectory() as tmp:
        bin_dir = Path(tmp, "bin")
        bin_dir.mkdir()
        (bin_dir / "gh").write_text(STUB)
        (bin_dir / "gh").chmod(0o755)
        for number, (name, head, activity, runs, expected, *commit_age) in enumerate(CASES):
            fixture = Path(tmp, str(number))
            fixture.mkdir()
            date = ago(commit_age[0] if commit_age else 600)
            (fixture / "commit.json").write_text(json.dumps({"sha": head, "commit": {"committer": {"date": date}}}))
            if activity is not None:
                (fixture / "activity.json").write_text(json.dumps(activity))
            (fixture / "runs.json").write_text(json.dumps(runs))
            env = {**os.environ, "PATH": f"{bin_dir}:{os.environ['PATH']}", "FIXTURE": str(fixture)}
            out = subprocess.run(["bash", "-c", cmd], capture_output=True, text=True, env=env)
            got = out.stdout.strip()
            if got != expected:
                failed += 1
                print(f"FAIL {name}: expected {expected!r}, got {got!r} {out.stderr.strip()[:200]}", file=sys.stderr)
    print(f"test-main-health: {'FAILED' if failed else 'ok'} ({len(CASES) - failed}/{len(CASES)} cases)")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(*sys.argv[1:]))
