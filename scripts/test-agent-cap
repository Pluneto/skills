#!/usr/bin/env python3
"""Test the workflow plugin's agent_cap hook (a sub-agent never runs above its parent) on fixture transcripts.

scripts/test-agent-cap

Each case writes a transcript and an optional agent definition into a temp folder, pipes a hook input
in the shape Claude Code 2.1 sends (`effort: {"level": ...}`) to the hook, and checks deny or allow.
"""
import json
import os
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HOOK = ROOT / "plugins" / "workflow" / "hooks" / "agent_cap.py"
ENV_KEYS = ("CLAUDE_CODE_SUBAGENT_MODEL", "CLAUDE_CODE_SUBAGENT_MODEL_FORCE", "CLAUDE_CODE_SUBAGENT_EFFORT",
            "AGENT_CAP_LOG")


class AgentCap(unittest.TestCase):
    def setUp(self):
        self.tmp = Path(tempfile.mkdtemp())
        self.config = self.tmp / "config"
        self.project = self.tmp / "project"
        (self.project / ".claude" / "agents").mkdir(parents=True)
        (self.config / "agents").mkdir(parents=True)

    def transcript(self, *records):
        path = self.tmp / "t.jsonl"
        path.write_text("".join(json.dumps(r) + "\n" for r in records))
        return path

    def run_hook(self, parent="claude-haiku-5-5", parent_effort="high", env=None, records=None, **tool_input):
        """parent: the newest api-request's model (None: no transcript). Returns the deny reason or None."""
        if records is None:
            records = [{"type": "assistant", "message": {"model": "claude-opus-5-5"}},  # an older turn
                       {"type": "api-request", "params": {"model": parent}}] if parent else []
        path = self.transcript(*records) if parent or records else self.tmp / "missing.jsonl"
        data = {"session_id": "s", "transcript_path": str(path), "cwd": str(self.project),
                "permission_mode": "bypassPermissions", "hook_event_name": "PreToolUse", "tool_name": "Agent",
                "tool_input": dict({"description": "d", "prompt": "p", "subagent_type": "general-purpose"},
                                   **tool_input)}
        if parent_effort:
            data["effort"] = {"level": parent_effort}
        run_env = {k: v for k, v in os.environ.items() if k not in ENV_KEYS}
        run_env.update(CLAUDE_CONFIG_DIR=str(self.config), **(env or {}))
        out = subprocess.run([sys.executable, str(HOOK)], input=json.dumps(data), capture_output=True, text=True,
                             env=run_env)
        self.assertEqual(out.returncode, 0, out.stderr)
        self.stderr = out.stderr
        if not out.stdout.strip():
            return None
        decision = json.loads(out.stdout)["hookSpecificOutput"]
        self.assertEqual(decision["permissionDecision"], "deny")
        return decision["permissionDecisionReason"]

    def agent(self, where, name, **front):
        body = "---\nname: " + name + "\n" + "".join(f"{k}: {v}\n" for k, v in front.items()) + "---\nDo it.\n"
        (where / f"{name}.md").write_text(body)

    # the #237 shape: a Haiku worker asking for Sonnet sub-agents
    def test_haiku_parent_denies_sonnet_and_allows_haiku(self):
        self.assertIn("claude-haiku-5-5", self.run_hook(model="sonnet"))
        self.assertIsNone(self.run_hook(model="haiku"))

    def test_sonnet_parent(self):
        self.assertIsNone(self.run_hook("claude-sonnet-5-5", model="haiku"))
        self.assertIsNone(self.run_hook("claude-sonnet-5-5", model="sonnet"))
        self.assertIn("never runs above", self.run_hook("claude-sonnet-5-5", model="opus"))

    def test_fable_is_always_denied(self):
        self.assertIn("excluded", self.run_hook("claude-opus-5-5", model="fable"))

    def test_omitted_model_inherits_and_is_allowed(self):
        self.assertIsNone(self.run_hook("claude-haiku-5-5"))

    def test_omitted_model_uses_the_project_agent_definition(self):
        self.agent(self.project / ".claude" / "agents", "deep", model="opus")
        self.assertIn("opus", self.run_hook("claude-sonnet-5-5", subagent_type="deep"))

    def test_omitted_model_uses_the_config_dir_agent_definition(self):  # the pool sets CLAUDE_CONFIG_DIR
        self.agent(self.config / "agents", "deep", model="opus")
        self.assertIn("opus", self.run_hook("claude-sonnet-5-5", subagent_type="deep"))

    def test_omitted_model_uses_a_plugin_agent_definition(self):
        where = self.config / "plugins" / "cache" / "mkt" / "tools" / "1.0.0" / "agents"
        where.mkdir(parents=True)
        self.agent(where, "deep", model="opus")
        self.assertIn("opus", self.run_hook("claude-sonnet-5-5", subagent_type="tools:deep"))

    def test_inherit_in_a_definition_is_allowed(self):
        self.agent(self.config / "agents", "same", model="inherit")
        self.assertIsNone(self.run_hook("claude-sonnet-5-5", subagent_type="same"))

    def test_subagent_model_env(self):
        self.assertIn("opus", self.run_hook("claude-sonnet-5-5", env={"CLAUDE_CODE_SUBAGENT_MODEL": "opus"}))
        forced = {"CLAUDE_CODE_SUBAGENT_MODEL": "opus", "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"}
        self.assertIn("opus", self.run_hook("claude-sonnet-5-5", env=forced, model="haiku"))

    def test_effort(self):
        self.assertIsNone(self.run_hook("claude-sonnet-5-5", "high", model="haiku", effort="high"))
        self.assertIsNone(self.run_hook("claude-sonnet-5-5", "high", model="haiku", effort="low"))
        self.assertIn("harder", self.run_hook("claude-sonnet-5-5", "high", model="haiku", effort="max"))
        self.assertIn("harder", self.run_hook("claude-sonnet-5-5", "high", model="haiku", effort="higher"))
        self.assertIsNone(self.run_hook("claude-sonnet-5-5", "high", model="haiku"))

    def test_effort_defaults_above_the_parent(self):
        self.agent(self.config / "agents", "thinker", model="haiku", effort="max")
        self.assertIn("harder", self.run_hook("claude-sonnet-5-5", "high", subagent_type="thinker"))
        env = {"CLAUDE_CODE_SUBAGENT_EFFORT": "xhigh"}
        self.assertIn("harder", self.run_hook("claude-sonnet-5-5", "high", env=env, model="haiku"))
        self.assertIn("harder", self.run_hook("claude-sonnet-5-5", "medium", env={"CLAUDE_CODE_SUBAGENT_EFFORT": "medium"},
                                             model="haiku", effort="higher"))

    def test_unknown_parent_effort_skips_the_effort_check(self):
        self.assertIsNone(self.run_hook("claude-sonnet-5-5", None, model="haiku", effort="max"))

    def test_assistant_record_counts_when_newest(self):
        records = [{"type": "api-request", "params": {"model": "claude-opus-5-5"}},
                   {"type": "assistant", "message": {"model": "claude-haiku-5-5"}},
                   {"type": "assistant", "message": {"model": "<synthetic>"}}]
        self.assertIn("claude-haiku-5-5", self.run_hook(records=records, model="sonnet"))

    def test_unreadable_transcript_allows_with_a_warning(self):
        self.assertIsNone(self.run_hook(None, model="opus"))
        self.assertIn("parent model unknown", self.stderr)

    def test_bad_input_allows_with_a_warning(self):
        out = subprocess.run([sys.executable, str(HOOK)], input="not json", capture_output=True, text=True)
        self.assertEqual((out.returncode, out.stdout), (0, ""))
        self.assertIn("allowed unchecked", out.stderr)


if __name__ == "__main__":
    unittest.main()
